# ============================================================
# NyayaBot Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# Keep real secrets out of Git history.

# ------ AI API Keys ------
# Google Gemini API key (primary LLM)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API key (optional fallback LLM)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------ Telegram Bot ------
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Public URL of your deployed Render service (for webhook mode)
# Example: https://nyayabot.onrender.com (or https://nyayabot.onrender.com/api/telegram-webhook)
# Leave blank when testing locally without webhooks
WEBHOOK_URL=https://your-service-name.onrender.com

# ------ Server Config ------
PORT=8000

# ------ Model Config (optional — defaults to gemini-3.5-flash-lite) ------
# GEMINI_MODEL=gemini-3.5-flash-lite
